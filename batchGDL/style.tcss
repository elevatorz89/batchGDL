TabPane {
    overflow-y: auto;
    border: hidden
}

.sidebar-layout {
    height: 1fr;
    width: 1fr;
}

SidebarTree {
    width: 32;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
    layout: vertical;
}

SidebarTree .sidebar-tree {
    height: 1fr;
    margin-bottom: 1;
}

Controls {
    width: 1fr;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

Controls ContentSwitcher {
    height: 1fr;
    width: 1fr;
}

Controls #content-download {
    height: 1fr;
    width: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-gutter: 1 1;
}

Controls #download-pane,
Controls EditPane {
    height: 1fr;
    width: 1fr;
}

Controls #download-tabs,
Controls #download-tabs > ContentSwitcher,
Controls #download-tabs TabPane {
    height: 1fr;
}

Controls #download-append-tab {
    overflow-y: auto;
    scrollbar-gutter: stable;
}

Controls EditPane {
    border: solid $primary;
    padding: 0 1;
}

Controls EditPane .edit-pane-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

Controls EditPane #edit-tabs {
    height: 1fr;
}

Controls EditPane TabPane {
    height: 1fr;
    overflow: hidden;
}

Controls EditPane #edit-list-switcher,
Controls EditPane #edit-list-switcher > Vertical {
    height: auto;
}

Controls EditPane Input {
    margin-bottom: 1;
}

Controls EditPane .list-modal-error {
    height: auto;
    margin-top: 0;
}

Controls EditPane .list-modal-actions {
    margin-top: 0;
}

Controls #content-search,
Controls #content-settings {
    height: 1fr;
    width: 1fr;
}

ItemGrid {
    padding: 0 4;
}

.selection-card {
    height: auto;
    margin: 1 4 0 4;
    padding: 0 1;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $boost;
}

.selection-card.-empty {
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
}

.selection-card-name {
    color: $text-accent;
}

.selection-card-details {
    color: $text;
    margin-top: 1;
}

.selection-card.-empty .selection-card-name,
.selection-card.-empty .selection-card-details {
    color: $text-muted;
    margin-top: 0;
}

.subs-horizontal {
    height: 3;
    align: left middle;
    content-align: center middle;
    width: auto;
    margin-top: 1;
    margin-left: 4;
}

.ignore-archive-label {
    margin-left: 2;
}

.refresh-button {
    height: 1;
    width: 100%;
    border: none;
    background: lightgray
}

.oauth-site-list {
    height: auto;
    max-height: 12;
}

.list-actions, .config-actions, .subs-actions {
    height: auto;
    margin-top: 1;
    grid-gutter: 1 1;
    width: 1fr;
}

.config-actions {
    margin-bottom: 1;
}

.list-actions Button, .config-actions Button, .subs-actions Button {
    width: 100%;
}

.oauth-grid {
    margin-top: 1
}

.list-modal-actions {
    layout: grid;
    grid-gutter: 1 1;
    height: auto;
    margin-top: 1;
    width: 1fr;
}

.list-modal-actions Button {
    width: 100%;
}

.list-modal {
    width: 70;
    height: auto;
    max-height: 80%;
    border: wide $primary;
    background: $surface;
    padding: 1 2;
}

.list-modal-scroll {
    max-height: 80%;
    scrollbar-gutter: stable;
}

.list-modal-scroll:focus {
    outline: none;
}

.list-modal-title {
    text-style: bold;
    margin-bottom: 1;
}

.list-modal-note {
    color: $text-muted;
    margin-bottom: 1;
}

.list-modal-error {
    color: $error;
    height: 1;
    margin-top: 1;
}

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.5);
}
